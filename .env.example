# === Copiez ce fichier en ".env" et remplissez vos propres cles ===
# Rien ici n'est jamais envoye ailleurs qu'a OANDA / FRED directement depuis votre machine.

# Mode de fonctionnement : "demo" (donnees simulees, aucune cle requise) ou "live" (vraies donnees OANDA)
APP_MODE=demo

# --- OANDA (https://www.oanda.com/demo-account/tpa/personal_finance) ---
# Un compte "practice" (demo) gratuit suffit pour recuperer les prix en temps reel.
OANDA_API_KEY=
OANDA_ACCOUNT_ID=
# "practice" ou "live"
OANDA_ENV=practice

# --- FRED (https://fred.stlouisfed.org/docs/api/api_key.html) ---
# Cle gratuite, sert a recuperer le taux reel US 10 ans (DFII10) pour le filtre macro.
FRED_API_KEY=

# Instrument OANDA pour l'or au comptant
GOLD_INSTRUMENT=XAU_USD

# Fuseau horaire d'affichage
DISPLAY_TZ=Asia/Dubai

# --- Production uniquement (Vercel) ---
# Mot de passe pour proteger le dashboard (laisser vide en local = pas de protection)
DASHBOARD_PASSWORD=

# Injecte automatiquement par l'integration "Vercel Postgres" -- ne pas remplir a la main.
# En local, laisser vide : l'app utilise alors SQLite (journal.db).
DATABASE_URL=
